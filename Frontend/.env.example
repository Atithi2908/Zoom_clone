# ==============================================================================
# Zoom Clone Frontend Environment Variables (Vercel)
# ==============================================================================

# Backend REST API base URL (No trailing slash)
# Local: http://localhost:8000
# Production: https://your-backend-name.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend-name.onrender.com

# Backend WebSocket signaling URL (ws:// for local, wss:// for production SSL)
# Local: ws://localhost:8000
# Production: wss://your-backend-name.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-backend-name.onrender.com
