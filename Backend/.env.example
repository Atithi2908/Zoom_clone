# ==============================================================================
# Zoom Clone Backend Environment Variables (Render)
# ==============================================================================

# Allowed Frontend URL for CORS (no trailing slash, comma-separated if multiple)
# Local: http://localhost:3000
# Production: https://your-zoom-app.vercel.app
FRONTEND_URL=https://your-zoom-app.vercel.app

# Secret key for signing JWT auth tokens
SECRET_KEY=generate-a-strong-random-secret-key-here-32-chars

# Password hashing salt (optional, defaults to secure fallback)
PASSWORD_SALT=zoom_clone_production_salt_2026

# Environment flag (set to 'production' on Render to disable auto-reload)
ENV=production
